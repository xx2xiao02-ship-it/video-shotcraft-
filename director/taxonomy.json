{
  "version": "1.0",
  "description": "视频分镜叙事分级体系",
  "levels": {
    "L1": {
      "hook": {
        "name": "钩子",
        "task": "3秒留人，制造认知缺口"
      },
      "pain": {
        "name": "痛点",
        "task": "戳中问题，放大焦虑"
      },
      "claim": {
        "name": "论点",
        "task": "提出核心观点/定义"
      },
      "proof": {
        "name": "论据",
        "task": "解释、举例、数据证明"
      },
      "quote": {
        "name": "金句",
        "task": "强调记忆点"
      },
      "cta": {
        "name": "行动",
        "task": "收尾号召"
      }
    },
    "L2": {
      "anti-common": {
        "name": "反常识钩子",
        "parent": "hook",
        "patterns": [
          "大多数人",
          "其实",
          "没想到",
          "越.*越",
          "不是.*而是"
        ]
      },
      "question": {
        "name": "提问钩子",
        "parent": "hook",
        "patterns": [
          "？",
          "吗？",
          "为什么",
          "有没有发现",
          "你知道吗"
        ]
      },
      "number": {
        "name": "数字钩子",
        "parent": "hook",
        "patterns": [
          "%",
          "倍",
          "万",
          "秒",
          "天",
          "个",
          "100",
          "90%"
        ]
      },
      "scene": {
        "name": "场景钩子",
        "parent": "hook",
        "patterns": [
          "每天",
          "当你",
          "如果",
          "假设"
        ]
      },
      "impact": {
        "name": "冲击钩子",
        "parent": "hook",
        "patterns": [
          "错了",
          "危险",
          "停",
          "别再",
          "停止"
        ]
      },
      "status": {
        "name": "现状描述",
        "parent": "pain",
        "patterns": [
          "现在",
          "如今",
          "现在的",
          "越来越"
        ]
      },
      "misconception": {
        "name": "误区揭露",
        "parent": "pain",
        "patterns": [
          "以为",
          "把.*当成",
          "误以为",
          "错误"
        ]
      },
      "anxiety": {
        "name": "焦虑放大",
        "parent": "pain",
        "patterns": [
          "焦虑",
          "焦虑",
          "浪费",
          "没用",
          "失败"
        ]
      },
      "compare": {
        "name": "对比反差",
        "parent": "pain",
        "patterns": [
          "不是.*而是",
          "看似.*其实",
          "别人.*你"
        ]
      },
      "definition": {
        "name": "核心定义",
        "parent": "claim",
        "patterns": [
          "这叫",
          "这就是",
          "定义",
          "概念"
        ]
      },
      "judgment": {
        "name": "对比判断",
        "parent": "claim",
        "patterns": [
          "不是.*而是",
          "真正",
          "本质上"
        ]
      },
      "concept": {
        "name": "概念命名",
        "parent": "claim",
        "patterns": [
          "叫",
          "命名",
          "称为",
          "所谓"
        ]
      },
      "example": {
        "name": "举例说明",
        "parent": "proof",
        "patterns": [
          "比如",
          "就像",
          "举个例子",
          "例如"
        ]
      },
      "data": {
        "name": "数据支撑",
        "parent": "proof",
        "patterns": [
          "数据",
          "研究",
          "统计",
          "调查",
          "显示"
        ]
      },
      "causal": {
        "name": "因果推理",
        "parent": "proof",
        "patterns": [
          "因为",
          "所以",
          "导致",
          "因此",
          "原因"
        ]
      },
      "method": {
        "name": "方法论",
        "parent": "proof",
        "patterns": [
          "方法",
          "步骤",
          "怎么做",
          "应该",
          "正确的",
          "技巧"
        ]
      },
      "process": {
        "name": "过程演示",
        "parent": "proof",
        "patterns": [
          "第一步",
          "然后",
          "接着",
          "最后"
        ]
      },
      "insight": {
        "name": "核心金句",
        "parent": "quote",
        "patterns": [
          "记住",
          "本质",
          "关键",
          "真正重要",
          "从来不是"
        ]
      },
      "emphasis": {
        "name": "强调引用",
        "parent": "quote",
        "patterns": [
          "最重要的",
          "核心",
          "本质",
          "关键在于"
        ]
      },
      "summary": {
        "name": "总结句",
        "parent": "cta",
        "patterns": [
          "总结",
          "总之",
          "所以",
          "综上"
        ]
      },
      "action": {
        "name": "行动号召",
        "parent": "cta",
        "patterns": [
          "开始",
          "停止",
          "行动",
          "现在",
          "去做",
          "试试"
        ]
      }
    },
    "L3": {
