  "slots": {
    "version": "1.0",
    "description": "镜头坑位治理主线：每个 shotCard 声明坑位类型与素材角色",
    "defaults": {
      "slot": "text-hero",
      "materialRole": "background"
    },
    "rules": [
      {
        "prefix": "typography/",
        "slot": "text-hero",
        "materialRole": "background",
        "note": "文字视觉为主，素材做底"
      },
      {
        "prefix": "data/",
        "slot": "data-show",
        "materialRole": "inline-element",
        "note": "数据可视化，素材进图表"
      },
      {
        "prefix": "camera/",
        "slot": "case-show",
        "materialRole": "hero",
        "note": "运镜叙事，素材全屏主体"
      },
      {
        "prefix": "ui-entrance/card-",
        "slot": "case-show",
        "materialRole": "split",
        "note": "卡片类，素材分屏嵌入"
      },
      {
        "prefix": "ui-entrance/",
        "slot": "process-show",
        "materialRole": "split",
        "note": "界面展示，素材分屏"
      },
      {
        "prefix": "interaction/",
        "slot": "process-show",
        "materialRole": "split",
        "note": "交互演示，素材分屏"
      },
      {
        "prefix": "transition/",
        "slot": "transition-slot",
        "materialRole": "none",
        "note": "转场纯模板"
      },
      {
        "prefix": "opening/",
        "slot": "text-hero",
        "materialRole": "background",
        "note": "开场大字，素材做底"
      },
      {
        "prefix": "outro/",
        "slot": "text-hero",
        "materialRole": "background",
        "note": "收尾大字，素材做底"
      },
      {
        "prefix": "rhythm/",
        "slot": "case-show",
        "materialRole": "hero",
        "note": "节奏剪辑，素材全屏"
      },
      {
        "prefix": "effects/",
        "slot": "text-hero",
        "materialRole": "background",
        "note": "特效衬托文字"
      }
    ],
    "overrides": {
      "data/before-after-slider-scrub": {
        "slot": "compare-slot",
        "materialRole": "split"
      },
      "data/avatar-grid-radial-build-colorize": {
        "slot": "data-show",
        "materialRole": "inline-element"
      },
      "camera/cursor-flyover": {
        "slot": "process-show",
        "materialRole": "split"
      },
      "camera/graze-face-tour": {
        "slot": "case-show",
        "materialRole": "hero"
      },
      "rhythm/quad-split-parallel-scenes": {
        "slot": "case-show",
        "materialRole": "inline-element"
      },
      "rhythm/speed-ramp-freeze": {
        "slot": "case-show",
        "materialRole": "hero"
      },
      "effects/scanline-annotate-focus": {
        "slot": "data-show",
        "materialRole": "inline-element"
      }
    }
  },
