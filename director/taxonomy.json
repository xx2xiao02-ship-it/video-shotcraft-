  "pitModel": {
    "L0_mode": [
      "A",
      "B",
      "C"
    ],
    "L1_subject": [
      "remotion",
      "local-material",
      "aigc-material",
      "person"
    ],
    "L2_content": [
      "text",
      "image",
      "video-local",
      "video-aigc"
    ],
    "L3_position": [
      "background",
      "element"
    ],
    "rules": [
      "A模式: remotion 主导，素材/人像做补充",
      "B模式: person 主导，remotion/素材穿插",
      "C模式: aigc-material 主导，remotion/person 做标注",
      "proof 类镜头在 A/C 模式优先用 local-material 做背景",
      "quote 类镜头在 A 模式优先选 loop 模板"
    ]
  }
}